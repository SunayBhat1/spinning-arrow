---
import Base from "../../layouts/Base.astro";
import data from "../../data/generated.json";

export function getStaticPaths() {
  return data.models.map((model) => ({ params: { slug: model.slug }, props: { model } }));
}

const { model } = Astro.props;
const base = import.meta.env.BASE_URL.endsWith("/")
  ? import.meta.env.BASE_URL
  : `${import.meta.env.BASE_URL}/`;
const responseIndex = data.exactResponses.filter((response) => response.modelId === model.id);
const items = Object.fromEntries(data.items.map((item) => [item.id, item]));
const phase3 = model.phase3.filter((row) => row.domain !== "ethics reference items");
---

<Base title={`${model.label} — Spinning Arrow`}>
  <section>
    <a class="back" href={`${base}models`}>← All models</a>
    <p class="eyebrow" style="margin-top:30px">Response profile</p>
    <h1>{model.label}</h1>
    <p class="small">Provider / lab: {model.lab}</p>
    <p class="lede">This page shows what this model answered under one precise survey condition: direct, first-person wording, with no evaluator context. It is a record of outputs, not a personality assessment.</p>
  </section>

  <section id="evidence" class="section">
    <div class="section-head"><div><p class="eyebrow">Survey responses</p><h2>Eight lenses, with the details one click away.</h2></div><a class="note" href={`${base}method#scores`}>How scores work →</a></div>
    <div class="scale-list">
      {model.scores.map((score) => {
        const info = data.scaleInfo[score.scale];
        const slug = score.scale.replaceAll(".", "-");
        return <a class="scale-link" href={`${base}metrics/${slug}`}>
          <p class="eyebrow">{info.label}</p><span class="scale-score">{Number(score.score).toFixed(1)} <small>/ 5</small></span><p>{info.plain}</p>
        </a>;
      })}
    </div>
  </section>

  <section class="section">
    <div class="section-head"><div><p class="eyebrow">Practical scenarios</p><h2>Did abstract answers carry into decisions?</h2></div><a class="note" href={`${base}method#phase3`}>Read the test design →</a></div>
    <div class="panel">
      {phase3.map((row) => <div class="stat-line"><strong>{row.domain}</strong><span>In {row.judged} scenarios with a clear prediction, the survey answer and modal practical choice lined up {row.concordant} times.</span><span class="small">Prompt-style difference: {Number(row.surfaceGap).toFixed(2)} on a 1–3 choice scale.</span></div>)}
    </div>
  </section>

  <section class="section">
    <p class="eyebrow">Evidence explorer</p><h2>See an exact answer.</h2>
    <p class="quiet-box">Choose a question below. This shows the exact prompt, the raw one-letter output, and the answer after its shuffled display position is mapped back to the original option.</p>
    <div class="response-explorer panel">
      <label for="response-picker" class="small">Question</label>
      <select id="response-picker">
        {responseIndex.map((response) => <option value={response.itemId}>{items[response.itemId].scale}: {items[response.itemId].text}</option>)}
      </select>
      <div id="response-output" class="response-output" aria-live="polite"></div>
    </div>
  </section>
</Base>

<script define:vars={{ responseIndex, items }}>
  const picker = document.querySelector("#response-picker");
  const output = document.querySelector("#response-output");
  const escapeHtml = (value) => String(value).replace(/[&<>'"]/g, (character) => ({ "&": "&amp;", "<": "&lt;", ">": "&gt;", "'": "&#39;", '"': "&quot;" })[character]);
  const render = () => {
    const response = responseIndex.find((entry) => entry.itemId === picker.value);
    const item = items[response.itemId];
    const choiceIndex = response.parsedChoice ? response.parsedChoice.charCodeAt(0) - 65 : -1;
    const selected = choiceIndex >= 0 ? item.options[choiceIndex] : null;
    const displayedLetter = choiceIndex >= 0 ? response.optionOrder[choiceIndex] : "—";
    output.innerHTML = `<p><strong>Resolved answer:</strong> ${selected ? `${escapeHtml(selected.label)} (${escapeHtml(response.parsedChoice)})` : "No usable parsed answer"}</p><p><strong>Raw output:</strong> <code>${escapeHtml(response.rawResponse ?? "—")}</code> · <strong>Displayed letter:</strong> ${escapeHtml(displayedLetter)}</p><pre>${escapeHtml(response.prompt)}</pre>`;
  };
  const itemFromLink = new URLSearchParams(window.location.search).get("item");
  if (itemFromLink && responseIndex.some((entry) => entry.itemId === itemFromLink)) picker.value = itemFromLink;
  picker.addEventListener("change", render);
  render();
</script>
