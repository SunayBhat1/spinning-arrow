---
import "../styles/global.css";

interface Props {
  title?: string;
  description?: string;
}

const {
  title = "Spinning Arrow — model response profiles",
  description = "A careful, transparent look at how language-model answers change across value questionnaires and practical scenarios.",
} = Astro.props;
const base = import.meta.env.BASE_URL;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <title>{title}</title>
  </head>
  <body>
    <header class="site-header">
      <a class="wordmark" href={base}>Spinning Arrow<span>◌</span></a>
      <nav aria-label="Primary navigation">
        <a href={`${base}models`}>Models</a>
        <a href={`${base}metrics`}>Metrics</a>
        <a href={`${base}patterns`}>Patterns</a>
        <a href={`${base}profile`}>Your profile</a>
        <a href={`${base}method`}>Method</a>
      </nav>
    </header>
    <main><slot /></main>
    <footer>
      <span>Spinning Arrow</span>
      <span>Prompt-conditioned evidence, not a verdict on a model’s values.</span>
    </footer>
  </body>
</html>
